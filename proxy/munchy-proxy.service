[Unit]
Description=Munchy FatSecret proxy
After=network-online.target
Wants=network-online.target
[Service]
User=munchy
Group=munchy
WorkingDirectory=/opt/munchy
EnvironmentFile=/etc/munchy-proxy.env
ExecStart=/opt/munchy/munchy-proxy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/munchy-proxy
[Install]
WantedBy=multi-user.target
