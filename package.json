{
  "name": "munchy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run assets && bun --bun next dev",
    "dev:full": "bun run assets && bun run scripts/dev-full.ts",
    "build": "bun run assets && bun --bun next build && bun run scripts/service-worker.ts",
    "start": "bun run scripts/serve.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "prepare": "husky",
    "assets": "bun run scripts/assets.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "proxy": "bun run proxy/src/server.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "next": "^16.1.6",
    "prettier": "3.7.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.6.0",
    "sql.js": "^1.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "@types/sql.js": "^1.4.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  }
}
