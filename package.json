{
  "name": "munchy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run assets && bun --bun next dev",
    "dev:full": "bun run assets && bun run scripts/dev-full.ts",
    "build": "bun run assets && bun --bun next build && bun run scripts/service-worker.ts",
    "start": "bun run scripts/serve.ts",
    "lint": "biome lint --error-on-warnings && eslint --max-warnings 0",
    "format": "eslint --fix --fix-type layout && biome check --write --linter-enabled=false",
    "prepare": "husky",
    "assets": "bun run scripts/assets.ts",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "biome check --error-on-warnings && eslint --max-warnings 0 && tsc --noEmit && knip && bun test tests",
    "proxy": "bun run proxy/src/server.ts",
    "deploy": "bun run scripts/deploy.ts"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "next": "^16.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.6.0",
    "sql.js": "^1.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.0.3",
    "husky": "^9.1.7",
    "knip": "^6.44.1",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "biome check --write --no-errors-on-unmatched",
      "eslint --fix"
    ],
    "*.{json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
